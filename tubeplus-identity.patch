diff --git a/smarttubetv/src/main/res/drawable/atv_progress.xml b/smarttubetv/src/main/res/drawable/atv_progress.xml
new file mode 100644
index 0000000..1c11f76
--- /dev/null
+++ b/smarttubetv/src/main/res/drawable/atv_progress.xml
@@ -0,0 +1,18 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Tube+ resume bar: soft track + violet fill -->
+<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
+    <item android:id="@android:id/background">
+        <shape android:shape="rectangle">
+            <corners android:radius="2dp"/>
+            <solid android:color="@color/atv_track"/>
+        </shape>
+    </item>
+    <item android:id="@android:id/progress">
+        <clip>
+            <shape android:shape="rectangle">
+                <corners android:radius="2dp"/>
+                <solid android:color="@color/atv_accent"/>
+            </shape>
+        </clip>
+    </item>
+</layer-list>
