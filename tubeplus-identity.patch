diff --git a/smarttubetv/src/main/res/values/styles.xml b/smarttubetv/src/main/res/values/styles.xml
index c8ef641..ced46f1 100644
--- a/smarttubetv/src/main/res/values/styles.xml
+++ b/smarttubetv/src/main/res/values/styles.xml
@@ -251,6 +251,9 @@
 
     <!--  Color scheme: Tube Glass (YouTube x Apple TV)  -->
     <!-- Rounded thumbnails (YouTube style). Used through the Leanback theme item imageCardViewImageStyle -->
+    <style name="AtvProgress" parent="@android:style/Widget.ProgressBar.Horizontal">
+        <item name="android:progressDrawable">@drawable/atv_progress</item>
+    </style>
     <style name="AtvCardImage">
         <item name="android:background">@drawable/atv_card_image_bg</item>
         <item name="android:clipToOutline" tools:targetApi="21">true</item>
@@ -259,7 +262,7 @@
         <item name="playbackProgressPrimaryColor">@color/atv_accent</item>
         <item name="playbackProgressSecondaryColor">@color/atv_progress_buffer</item>
         <item name="playbackControlsIconHighlightColor">@color/white</item>
-        <item name="cardProgressStyle">@style/ProgressBarHorizontal.Dark</item>
+        <item name="cardProgressStyle">@style/AtvProgress</item>
         <item name="shelfBackground">@color/scheme_grey_shelf_background_dark</item>
         <item name="cardDefaultBackground">@color/atv_card</item>
         <item name="android:colorAccent" tools:targetApi="21">@color/white</item>
@@ -273,7 +276,7 @@
         <!-- YouTube: no box around the video title, only the rounded thumbnail -->
         <item name="cardDefaultBackground">@color/atv_transparent</item>
         <item name="imageCardViewImageStyle">@style/AtvCardImage</item>
-        <item name="cardProgressStyle">@style/ProgressBarHorizontal.Dark</item>
+        <item name="cardProgressStyle">@style/AtvProgress</item>
         <item name="android:colorAccent" tools:targetApi="21">@color/white</item>
