diff --git a/smarttubetv/src/main/res/values/colors.xml b/smarttubetv/src/main/res/values/colors.xml
index e9a6c17..20aa980 100644
--- a/smarttubetv/src/main/res/values/colors.xml
+++ b/smarttubetv/src/main/res/values/colors.xml
@@ -76,18 +76,20 @@
     <!-- Soft light wash (Apple TV "lit wall") and faint YouTube-red glow in the page backdrop -->
     <color name="atv_glow_light">#2EFFFFFF</color>
     <color name="atv_glow_light_end">#00FFFFFF</color>
-    <color name="atv_glow_red">#38FF0033</color>
-    <color name="atv_glow_red_end">#00FF0033</color>
+    <color name="atv_glow_red">#407C5CFF</color>
+    <color name="atv_glow_red_end">#007C5CFF</color>
     <!-- Text and focus pill -->
     <color name="atv_text_primary">#FFF1F1F1</color>
     <color name="atv_text_on_pill">#FF0F0F0F</color>
     <color name="atv_pill">#F5FFFFFF</color>
     <!-- YouTube red for the player progress; buffered part is a translucent white -->
-    <color name="atv_accent">#FFFF0000</color>
+    <color name="atv_accent">#FF7C5CFF</color>
     <color name="atv_progress_buffer">#80FFFFFF</color>
     <!-- Dialogs / settings pane tint (the window blur sits behind it on Android 12+) -->
     <color name="atv_dialog_tint">#B30F0F0F</color>
     <!-- Player: only a very light dim over the video; the eased bottom scrim (atv_player_scrim) does the rest.
          Overrides the leanback default (#80000000) used by PlaybackSupportFragment.BG_LIGHT -->
     <color name="lb_playback_controls_background_light">#14000000</color>
+    <color name="atv_accent_alt">#FF22D3EE</color>
+    <color name="atv_track">#40FFFFFF</color>
 </resources>
