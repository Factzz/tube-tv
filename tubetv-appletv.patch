+<?xml version="1.0" encoding="utf-8"?>
+<!-- Tube Glass backdrop: YouTube near-black, a soft neutral "lit wall" glow top-left (Apple TV)
+     and a faint YouTube-red glow bottom-right -->
+<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
+    <item>
+        <shape android:shape="rectangle">
+            <solid android:color="@color/atv_base"/>
+        </shape>
+    </item>
+    <item>
+        <shape android:shape="rectangle">
+            <gradient
+                android:type="radial"
+                android:centerX="0.18"
+                android:centerY="0.0"
+                android:gradientRadius="1000dp"
+                android:startColor="@color/atv_glow_light"
+                android:endColor="@color/atv_glow_light_end"/>
+        </shape>
+    </item>
+    <item>
+        <shape android:shape="rectangle">
+            <gradient
+                android:type="radial"
+                android:centerX="0.98"
+                android:centerY="1.0"
+                android:gradientRadius="800dp"
+                android:startColor="@color/atv_glow_red"
+                android:endColor="@color/atv_glow_red_end"/>
+        </shape>
