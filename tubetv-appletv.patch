diff --git a/smarttubetv/src/main/java/com/liskovsoft/smartyoutubetv2/tv/ui/widgets/glass/FrostedGlassView.java b/smarttubetv/src/main/java/com/liskovsoft/smartyoutubetv2/tv/ui/widgets/glass/FrostedGlassView.java
new file mode 100644
index 0000000..da78424
--- /dev/null
+++ b/smarttubetv/src/main/java/com/liskovsoft/smartyoutubetv2/tv/ui/widgets/glass/FrostedGlassView.java
@@ -0,0 +1,320 @@
+package com.liskovsoft.smartyoutubetv2.tv.ui.widgets.glass;
+
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.ColorMatrix;
+import android.graphics.ColorMatrixColorFilter;
+import android.graphics.LinearGradient;
+import android.graphics.Outline;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.RectF;
+import android.graphics.RenderEffect;
+import android.graphics.Shader;
+import android.os.Build;
+import android.os.Handler;
+import android.os.Looper;
+import android.util.AttributeSet;
+import android.view.View;
+import android.view.ViewOutlineProvider;
+import android.widget.FrameLayout;
+
+import androidx.annotation.RequiresApi;
+
+/**
+ * Frosted glass sheet (YouTube x Apple TV sidebar).
+ * <p>
+ * Same recipe as the PLAYVIZ "Glass" panel:
+ * <ol>
+ *     <li>a tiny live snapshot of whatever is on screen behind the panel, blurred
+ *     (GPU blur + saturation boost on Android 12+, small CPU box blur on older boxes)</li>
+ *     <li>a dark tint</li>
+ *     <li>a diagonal white sheen</li>
+ *     <li>a thin light rim that is brighter on the top-left and bottom-right corners</li>
+ * </ol>
+ * The snapshot is only a few thousand pixels, so a refresh every 0.1 s is cheap even on weak TV boxes.
+ * The parent of this view (the sidebar root) is made fully transparent while the snapshot is taken,
+ * so the glass never captures itself.
+ */
+public class FrostedGlassView extends FrameLayout {
+    /** How often the backdrop is refreshed */
+    private static final long CAPTURE_INTERVAL_MS = 100;
+    /** Snapshot is this many times smaller than the panel: smaller = faster and softer */
+    private static final int DOWNSCALE = 8;
+    /** Android < 12 fallback: box blur radius / passes in snapshot pixels */
+    private static final int CPU_BLUR_RADIUS = 3;
+    private static final int CPU_BLUR_PASSES = 2;
+    /** Android 12+: GPU blur radius */
+    private static final float GPU_BLUR_DP = 14f;
+    private static final float GPU_SATURATION = 1.45f;
+    private static final float CORNER_DP = 30f;
+    private static final float RIM_DP = 1.2f;
+    /** Shown where the snapshot is transparent (page background colour) */
+    private static final int BASE_COLOR = 0xFF0F0F0F;
+
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+    private final BlurLayer mBlurLayer;
+    private final Paint mTintPaint = new Paint();
+    private final Paint mSheenPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mRimPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Path mClipPath = new Path();
+    private final RectF mRect = new RectF();
+    private final RectF mRimRect = new RectF();
+    private final int[] mViewLoc = new int[2];
+    private final int[] mRootLoc = new int[2];
+    private final float mCorner;
+    private final float mRim;
+
+    private Bitmap mBitmap;
+    private Canvas mBitmapCanvas;
+    private int[] mPixels;
+    private int[] mTmp;
+    private boolean mRunning;
+    private boolean mCapturing;
+
+    private final Runnable mTick = new Runnable() {
+        @Override
+        public void run() {
+            if (!mRunning) {
+                return;
+            }
+
+            try {
+                capture();
+            } catch (RuntimeException e) {
+                // Never let a failed snapshot crash the UI: keep the previous frame
+            }
+
+            mHandler.postDelayed(this, CAPTURE_INTERVAL_MS);
+        }
+    };
+
+    public FrostedGlassView(Context context) {
+        this(context, null);
+    }
+
+    public FrostedGlassView(Context context, AttributeSet attrs) {
+        this(context, attrs, 0);
+    }
+
+    public FrostedGlassView(Context context, AttributeSet attrs, int defStyleAttr) {
+        super(context, attrs, defStyleAttr);
+
+        float density = context.getResources().getDisplayMetrics().density;
+        mCorner = CORNER_DP * density;
+        mRim = RIM_DP * density;
+
+        mTintPaint.setColor(0x33000000);
+
+        mRimPaint.setStyle(Paint.Style.STROKE);
+        mRimPaint.setStrokeWidth(mRim);
+
+        mBlurLayer = new BlurLayer(context);
+        addView(mBlurLayer, new LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.MATCH_PARENT));
+
+        if (Build.VERSION.SDK_INT >= 21) {
+            setOutlineProvider(new ViewOutlineProvider() {
+                @Override
+                public void getOutline(View view, Outline outline) {
+                    outline.setRoundRect(0, 0, view.getWidth(), view.getHeight(), mCorner);
+                }
+            });
+            setClipToOutline(true);
+        }
+
+        if (Build.VERSION.SDK_INT >= 31) {
+            applyGpuBlur();
+        }
+    }
+
+    @RequiresApi(31)
+    private void applyGpuBlur() {
+        float radius = GPU_BLUR_DP * getResources().getDisplayMetrics().density;
+        RenderEffect blur = RenderEffect.createBlurEffect(radius, radius, Shader.TileMode.CLAMP);
+        ColorMatrix matrix = new ColorMatrix();
+        matrix.setSaturation(GPU_SATURATION);
+        // Colour boost is applied on top of the blurred result ("vibrancy")
+        mBlurLayer.setRenderEffect(RenderEffect.createColorFilterEffect(new ColorMatrixColorFilter(matrix), blur));
+    }
+
+    @Override
+    protected void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        mRunning = true;
+        mHandler.removeCallbacks(mTick);
+        mHandler.post(mTick);
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        mRunning = false;
+        mHandler.removeCallbacks(mTick);
+        super.onDetachedFromWindow();
+    }
+
+    @Override
+    protected void onSizeChanged(int w, int h, int oldw, int oldh) {
+        super.onSizeChanged(w, h, oldw, oldh);
+
+        mRect.set(0, 0, w, h);
+        mRimRect.set(mRim / 2f, mRim / 2f, w - mRim / 2f, h - mRim / 2f);
+
+        mClipPath.reset();
+        mClipPath.addRoundRect(mRect, mCorner, mCorner, Path.Direction.CW);
+
+        mSheenPaint.setShader(new LinearGradient(0, 0, w, h, 0x38FFFFFF, 0x06FFFFFF, Shader.TileMode.CLAMP));
+        mRimPaint.setShader(new LinearGradient(0, 0, w, h,
+                new int[] {0xA0FFFFFF, 0x14FFFFFF, 0x55FFFFFF}, new float[] {0f, 0.5f, 1f}, Shader.TileMode.CLAMP));
+    }
+
+    @Override
+    protected void dispatchDraw(Canvas canvas) {
+        if (Build.VERSION.SDK_INT < 21) {
+            canvas.save();
+            canvas.clipPath(mClipPath);
+        }
+
+        super.dispatchDraw(canvas); // blurred snapshot
+
+        if (!mCapturing) {
+            canvas.drawRect(mRect, mTintPaint);
+            canvas.drawRect(mRect, mSheenPaint);
+            canvas.drawRoundRect(mRimRect, mCorner - mRim / 2f, mCorner - mRim / 2f, mRimPaint);
+        }
+
+        if (Build.VERSION.SDK_INT < 21) {
+            canvas.restore();
+        }
+    }
+
+    private void capture() {
+        int width = getWidth();
+        int height = getHeight();
+
+        if (!isShown() || width <= 0 || height <= 0) {
+            return;
+        }
+
+        View root = getRootView();
+        getLocationInWindow(mViewLoc);
+        root.getLocationInWindow(mRootLoc);
+        int left = mViewLoc[0] - mRootLoc[0];
+        int top = mViewLoc[1] - mRootLoc[1];
+
+        // Sidebar is slid off screen: nothing to show
+        if (left + width <= 0 || left >= root.getWidth()) {
+            return;
+        }
+
+        int bw = Math.max(1, width / DOWNSCALE);
+        int bh = Math.max(1, height / DOWNSCALE);
+
+        if (mBitmap == null || mBitmap.getWidth() != bw || mBitmap.getHeight() != bh) {
+            mBitmap = Bitmap.createBitmap(bw, bh, Bitmap.Config.ARGB_8888);
+            mBitmapCanvas = new Canvas(mBitmap);
+            mPixels = new int[bw * bh];
+            mTmp = new int[bw * bh];
+        }
+
+        // Hide the whole sidebar panel (this view's parent) while snapshotting
+        View panel = getParent() instanceof View ? (View) getParent() : null;
+        float oldAlpha = panel != null ? panel.getAlpha() : 1f;
+
+        mBitmap.eraseColor(BASE_COLOR);
+        mBitmapCanvas.save();
+        mBitmapCanvas.scale(bw / (float) width, bh / (float) height);
+        mBitmapCanvas.translate(-left, -top);
+
+        mCapturing = true;
+        try {
+            if (panel != null) {
+                panel.setAlpha(0f);
+            }
+            root.draw(mBitmapCanvas);
+        } finally {
+            mCapturing = false;
+            if (panel != null) {
+                panel.setAlpha(oldAlpha);
+            }
+            mBitmapCanvas.restore();
+        }
+
+        if (Build.VERSION.SDK_INT < 31) {
+            // No GPU blur: soften the tiny snapshot on the CPU
+            mBitmap.getPixels(mPixels, 0, bw, 0, 0, bw, bh);
+            for (int i = 0; i < CPU_BLUR_PASSES; i++) {
+                blurPass(mPixels, mTmp, bw, bh, CPU_BLUR_RADIUS, true);
+                blurPass(mTmp, mPixels, bw, bh, CPU_BLUR_RADIUS, false);
+            }
+            mBitmap.setPixels(mPixels, 0, bw, 0, 0, bw, bh);
+        }
+
+        mBlurLayer.setBitmap(mBitmap);
+    }
+
+    /** One separable box-blur pass (edges clamped). Reads src, writes dst. */
+    private static void blurPass(int[] src, int[] dst, int w, int h, int r, boolean horizontal) {
+        int div = 2 * r + 1;
+        int lines = horizontal ? h : w;
+        int len = horizontal ? w : h;
+
+        for (int line = 0; line < lines; line++) {
+            int red = 0, green = 0, blue = 0;
+
+            for (int i = -r; i <= r; i++) {
+                int p = src[pos(line, clamp(i, len), w, horizontal)];
+                red += (p >> 16) & 0xff;
+                green += (p >> 8) & 0xff;
+                blue += p & 0xff;
+            }
+
+            for (int i = 0; i < len; i++) {
+                dst[pos(line, i, w, horizontal)] =
+                        0xFF000000 | ((red / div) << 16) | ((green / div) << 8) | (blue / div);
+
+                int add = src[pos(line, clamp(i + r + 1, len), w, horizontal)];
+                int sub = src[pos(line, clamp(i - r, len), w, horizontal)];
+                red += ((add >> 16) & 0xff) - ((sub >> 16) & 0xff);
+                green += ((add >> 8) & 0xff) - ((sub >> 8) & 0xff);
+                blue += (add & 0xff) - (sub & 0xff);
+            }
+        }
+    }
+
+    private static int clamp(int i, int len) {
+        return i < 0 ? 0 : (i >= len ? len - 1 : i);
+    }
+
+    private static int pos(int line, int idx, int w, boolean horizontal) {
+        return horizontal ? line * w + idx : idx * w + line;
+    }
+
+    /** Draws the snapshot stretched over the whole panel. On Android 12+ the GPU blur is applied to this view. */
+    private static class BlurLayer extends View {
+        private final Paint mPaint = new Paint(Paint.FILTER_BITMAP_FLAG);
+        private final RectF mDst = new RectF();
+        private Bitmap mShown;
+
+        BlurLayer(Context context) {
+            super(context);
+        }
+
+        void setBitmap(Bitmap bitmap) {
+            mShown = bitmap;
+            invalidate();
+        }
+
+        @Override
+        protected void onDraw(Canvas canvas) {
+            if (mShown == null) {
+                canvas.drawColor(BASE_COLOR);
+                return;
+            }
+
+            mDst.set(0, 0, getWidth(), getHeight());
+            canvas.drawBitmap(mShown, null, mDst, mPaint);
+        }
+    }
+}
