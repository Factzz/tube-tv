diff --git a/smarttubetv/src/main/res/values-v31/styles.xml b/smarttubetv/src/main/res/values-v31/styles.xml
new file mode 100644
index 0000000..37045e9
--- /dev/null
+++ b/smarttubetv/src/main/res/values-v31/styles.xml
@@ -0,0 +1,12 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources xmlns:tools="http://schemas.android.com/tools">
+    <!-- Android 12+: real background blur behind dialogs / settings panels (frosted glass) -->
+    <style name="App.Theme.AppleTV.Preferences" parent="App.Theme.Leanback.Preferences">
+        <item name="android:windowBackground">@drawable/atv_dialog_bg</item>
+        <item name="android:colorAccent">@color/white</item>
+        <item name="android:colorPrimary">@color/scheme_grey_background</item>
+        <item name="android:windowBackgroundBlurRadius">96dp</item>
+        <item name="android:windowBlurBehindEnabled">true</item>
+        <item name="android:windowBlurBehindRadius">48dp</item>
+    </style>
+</resources>
diff --git a/smarttubetv/src/main/res/values/atv_attrs.xml b/smarttubetv/src/main/res/values/atv_attrs.xml
new file mode 100644
index 0000000..ee3727a
--- /dev/null
+++ b/smarttubetv/src/main/res/values/atv_attrs.xml
@@ -0,0 +1,5 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <!-- Already declared by AndroidX Leanback (same format). Declared here too so the theme item below always resolves -->
+    <attr name="imageCardViewImageStyle" format="reference"/>
+</resources>
diff --git a/smarttubetv/src/main/res/values/colors.xml b/smarttubetv/src/main/res/values/colors.xml
index dfc7d18..bf15b19 100644
--- a/smarttubetv/src/main/res/values/colors.xml
+++ b/smarttubetv/src/main/res/values/colors.xml
@@ -68,4 +68,26 @@
     <color name="lb_speech_orb_not_recording">@color/orb_color</color>
     <color name="lb_speech_orb_not_recording_pulsed">@color/orb_bright_color</color>
     <color name="lb_speech_orb_not_recording_icon">@color/orb_icon_color</color>
+    <!-- ===== Tube Glass: YouTube x Apple TV ===== -->
+    <!-- YouTube dark surfaces -->
+    <color name="atv_base">#FF0F0F0F</color>
+    <color name="atv_card">#FF272727</color>
+    <color name="atv_transparent">#00000000</color>
+    <!-- Soft light wash (Apple TV "lit wall") and faint YouTube-red glow in the page backdrop -->
+    <color name="atv_glow_light">#2EFFFFFF</color>
