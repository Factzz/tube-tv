diff --git a/smarttubetv/src/main/res/values-v31/styles.xml b/smarttubetv/src/main/res/values-v31/styles.xml
new file mode 100644
index 0000000..0e7728b
--- /dev/null
+++ b/smarttubetv/src/main/res/values-v31/styles.xml
@@ -0,0 +1,12 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources xmlns:tools="http://schemas.android.com/tools">
+    <!-- Android 12+: real background blur behind dialogs / settings panels (frosted glass) -->
+    <style name="App.Theme.AppleTV.Preferences" parent="App.Theme.Leanback.Preferences">
+        <item name="android:windowBackground">@drawable/atv_dialog_bg</item>
+        <item name="android:colorAccent">@color/white</item>
+        <item name="android:colorPrimary">@color/scheme_grey_background</item>
+        <item name="android:windowBackgroundBlurRadius">80dp</item>
+        <item name="android:windowBlurBehindEnabled">true</item>
+        <item name="android:windowBlurBehindRadius">40dp</item>
+    </style>
+</resources>
diff --git a/smarttubetv/src/main/res/values/colors.xml b/smarttubetv/src/main/res/values/colors.xml
index dfc7d18..bf15b19 100644
--- a/smarttubetv/src/main/res/values/colors.xml
+++ b/smarttubetv/src/main/res/values/colors.xml
@@ -68,4 +68,29 @@
     <color name="lb_speech_orb_not_recording">@color/orb_color</color>
     <color name="lb_speech_orb_not_recording_pulsed">@color/orb_bright_color</color>
     <color name="lb_speech_orb_not_recording_icon">@color/orb_icon_color</color>
+
+    <!-- ===== Apple TV style (glass + gradient) ===== -->
+    <color name="atv_base">#FF0B0B10</color>
+    <color name="atv_glow_amber">#B3F08A2E</color>
+    <color name="atv_glow_amber_end">#00F08A2E</color>
+    <color name="atv_glow_violet">#66503AA8</color>
+    <color name="atv_glow_violet_end">#00503AA8</color>
+    <color name="atv_glass_top">#59FFFFFF</color>
+    <color name="atv_glass_bottom">#26FFFFFF</color>
+    <color name="atv_glass_dark_top">#8C2A2A33</color>
+    <color name="atv_glass_dark_bottom">#B31A1A20</color>
+    <color name="atv_glass_stroke">#40FFFFFF</color>
+    <color name="atv_pill">#F2FFFFFF</color>
+    <color name="atv_text_primary">#FFFFFFFF</color>
+    <color name="atv_text_on_pill">#FF111114</color>
+    <color name="atv_progress_track">#40FFFFFF</color>
+    <color name="atv_progress_buffer">#66FFFFFF</color>
+    <color name="atv_scrim_top">#00000000</color>
+    <color name="atv_scrim_bottom">#E6000000</color>
+    <color name="atv_dialog_tint">#8C0B0B10</color>
+    <color name="atv_transparent">#00000000</color>
+    <color name="atv_card">#FF1C1C23</color>
+    <!-- Player: only a light dim over the video; the bottom scrim (atv_player_scrim) does the rest.
+         Overrides the leanback default (#80000000) used by PlaybackSupportFragment.BG_LIGHT -->
+    <color name="lb_playback_controls_background_light">#26000000</color>
 </resources>
